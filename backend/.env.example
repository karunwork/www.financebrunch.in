# Finance Brunch Backend Environment Variables
# Copy this file to .env and supply your credentials.
# NEVER commit the real .env file with secrets to Git!

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://arasadaanishkarthik.github.io,http://localhost:8080,http://localhost:5173

# YouTube Integration
# Official Channel ID: UCgtssmXPtGcirH61m0MjrLQ
# If YOUTUBE_API_KEY is not provided, the server automatically uses the channel's live RSS/Atom feed.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCgtssmXPtGcirH61m0MjrLQ
YOUTUBE_CACHE_TTL_MS=3600000

# Google Reviews Integration
# Get your Google Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
# Get a Google Places API Key: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
REVIEWS_CACHE_TTL_MS=86400000
