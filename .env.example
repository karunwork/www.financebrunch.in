# Finance Brunch Frontend Environment Variables
# Copy this file to .env.local for local overrides or configure in your deployment CI/CD.
# NEVER commit real credentials or secrets to Git.

# Optional backend API URL
# Default during local development: http://localhost:5000 (auto-detected when browsing on localhost)
# For production GitHub Pages build: set to your deployed backend origin (e.g., https://your-backend.onrender.com)
VITE_API_URL=
